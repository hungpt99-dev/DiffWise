{
  "name": "diffwise",
  "private": true,
  "version": "0.4.0",
  "description": "DiffWise \u2014 CLI-first AI engineering review platform: review, findings, chat, fixes, verification and a web report.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "npm run build -w @diffwise/core && npm run build -w @diffwise/ai && npm run build -w @diffwise/app && npm run build -w @diffwise/mcp && npm run build -w @diffwise/cli && npm run build -w @diffwise/webview && npm run build -w diffwise-vscode",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run e2e -w @diffwise/webview",
    "package:vsix": "npm run package -w diffwise-vscode",
    "verify": "npm run typecheck && npm run test",
    "pretest": "npm run build",
    "test:unit": "vitest run",
    "test:ui": "npm run e2e -w @diffwise/webview",
    "demo": "node demo/build-demo-repo.mjs --target /tmp/diffwise-demo",
    "review": "node scripts/analyze.mjs",
    "cli": "node packages/cli/bin/diffwise.js",
    "test:e2e:web": "node packages/webview/e2e/run-e2e.mjs",
    "evidence": "node tools/evidence/capture.mjs",
    "eval": "node packages/cli/bin/diffwise.js evaluate",
    "eval:build": "node evals/build-fixtures.mjs",
    "bench": "tsx tools/bench/token-bench.ts",
    "bench:calibrate": "node tools/bench/token-calibration.mjs",
    "evidence:ui": "node tools/evidence/ui-shots.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vscode/vsce": "^3.2.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild": "^0.24.0",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
